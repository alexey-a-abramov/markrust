---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';

const headings = [
  { id: 'headings', text: 'Headings', level: 2 },
  { id: 'emphasis', text: 'Emphasis', level: 2 },
  { id: 'lists', text: 'Lists', level: 2 },
  { id: 'links', text: 'Links', level: 2 },
  { id: 'gfm', text: 'GitHub Flavored Markdown', level: 2 },
];
---

<DocsLayout title="Markdown" headings={headings}>
  <p>MarkRust supports standard Markdown and GitHub Flavored Markdown (GFM). Files are stored as plain text.</p>

  <h2 id="headings">Headings</h2>
  <CodeBlock code={`# Heading 1\n## Heading 2\n### Heading 3`} lang="markdown" />

  <h2 id="emphasis">Emphasis</h2>
  <CodeBlock code="**bold** and *italic* and `inline code`" lang="markdown" />

  <h2 id="lists">Lists</h2>
  <CodeBlock code={`- Item one\n- Item two\n  - Nested\n\n1. Ordered\n2. List`} lang="markdown" />

  <h2 id="links">Links</h2>
  <CodeBlock code="[MarkRust](https://markrust.org)" lang="markdown" />

  <h2 id="gfm">GitHub Flavored Markdown</h2>
  <ul>
    <li>Task lists: <code>- [ ]</code> / <code>- [x]</code></li>
    <li>Tables: pipe-delimited syntax</li>
    <li>Fenced code blocks with language tags</li>
    <li>Blockquotes with <code>&gt;</code></li>
    <li>YAML frontmatter at document top</li>
  </ul>
  <p>See individual pages for <a href="/docs/tables">tables</a>, <a href="/docs/code-blocks">code blocks</a>, and <a href="/docs/frontmatter">frontmatter</a>.</p>
</DocsLayout>
