---
import DocsLayout from '../../layouts/DocsLayout.astro';
---

<DocsLayout title="Command palette">
  <p>Press <kbd>⌘P</kbd> (macOS) or <kbd>Ctrl+P</kbd> (Linux) to open the command palette.</p>

  <h2>Available commands</h2>
  <ul>
    <li>Switch between open files</li>
    <li>Export HTML (requires saved file path)</li>
    <li>Toggle light/dark theme</li>
  </ul>

  <h2>File switcher</h2>
  <p>The palette lists open tabs. Select a file to focus its tab.</p>
</DocsLayout>
