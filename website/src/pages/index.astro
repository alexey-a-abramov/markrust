---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AppMockup from '../components/AppMockup.astro';
import CodeBlock from '../components/CodeBlock.astro';
---

<BaseLayout
  title="MarkRust"
  description="Markdown, without the machinery. A fast, local-first Markdown editor. Free and open source."
>
  <Header />
  <main>
    <section class="hero">
      <div class="hero__masthead container">
        <div class="hero__meta">
          <span>v0.1.0</span>
          <span>MPL-2.0</span>
          <span>local-first</span>
          <span>no account</span>
        </div>
        <h1 class="hero__title">
          Markdown,<br />
          <em>without the machinery.</em>
        </h1>
        <div class="hero__lead">
          <p>
            A native editor for ordinary <code>.md</code> files.
            Fast enough to disappear. Free and open source.
          </p>
          <div class="hero__actions">
            <a href="#download" class="btn btn--primary">Download MarkRust</a>
            <a href="https://github.com/alexey-a-abramov/markrust" class="btn btn--secondary" target="_blank" rel="noopener noreferrer">View source</a>
          </div>
        </div>
      </div>

      <div class="hero__stage">
        <div class="container">
          <div class="hero__install">
            <span class="hero__prompt">$</span>
            <code>cargo install --git https://github.com/alexey-a-abramov/markrust markrust</code>
            <button type="button" class="hero__copy" data-copy="cargo install --git https://github.com/alexey-a-abramov/markrust markrust">Copy</button>
          </div>
          <div class="hero__visual">
            <AppMockup />
          </div>
        </div>
      </div>
    </section>

    <section class="principles" id="principles">
      <div class="container">
        <header class="band">
          <p class="label">01 — Principles</p>
          <p class="band__aside">Four constraints. No more.</p>
        </header>
        <div class="principles__grid">
          <article class="principle">
            <p class="principle__num" aria-hidden="true">01</p>
            <div class="principle__body">
              <h2>Your files are the product.</h2>
              <p>MarkRust reads and writes ordinary Markdown. No proprietary document database. Open a folder. Keep the files.</p>
            </div>
          </article>
          <article class="principle">
            <p class="principle__num" aria-hidden="true">02</p>
            <div class="principle__body">
              <h2>Fast means fast.</h2>
              <p>Launch quickly, handle large documents smoothly, stay out of the way. Performance is a feature, not a slogan.</p>
            </div>
          </article>
          <article class="principle">
            <p class="principle__num" aria-hidden="true">03</p>
            <div class="principle__body">
              <h2>Local first.</h2>
              <p>No account required. No connection required. The editor works on a machine that never leaves your desk.</p>
            </div>
          </article>
          <article class="principle">
            <p class="principle__num" aria-hidden="true">04</p>
            <div class="principle__body">
              <h2>Free forever.</h2>
              <p>Open source. The core product is not a trial for something else. There is no Pro editor behind the download.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="features" id="features">
      <div class="container">
        <header class="band">
          <p class="label">02 — Capabilities</p>
          <p class="band__aside">Source on the left. Rendered on the right.</p>
        </header>
        <div class="features__split">
          <div class="feature-demo" aria-label="Markdown source and rendered output">
            <div class="feature-demo__pane">
              <p class="feature-demo__caption">source.md</p>
              <pre><code><span class="tok-h"># Roadmap</span>

<span class="tok-task">- [x]</span> Markdown parser
<span class="tok-task">- [x]</span> Workspace
<span class="tok-task">- [ ]</span> World domination

<span class="tok-pipe">| Feature | Status |</span>
<span class="tok-pipe">|---------|--------|</span>
<span class="tok-pipe">| Tables  | done   |</span></code></pre>
            </div>
            <div class="feature-demo__pane feature-demo__pane--render">
              <p class="feature-demo__caption">preview</p>
              <p class="render-h1">Roadmap</p>
              <p><span class="check">☑</span> Markdown parser</p>
              <p><span class="check">☑</span> Workspace</p>
              <p><span class="box">☐</span> World domination</p>
              <table class="mini-table">
                <thead><tr><th>Feature</th><th>Status</th></tr></thead>
                <tbody><tr><td>Tables</td><td>done</td></tr></tbody>
              </table>
            </div>
          </div>
          <ol class="index">
            <li><code>#</code> Write</li>
            <li><code>&gt;</code> Preview inline</li>
            <li><code>§</code> Navigate outline</li>
            <li><code>/</code> Search in document</li>
            <li><code>⌘P</code> Command palette</li>
            <li><code>git</code> Plain files</li>
            <li><code>---</code> YAML frontmatter</li>
            <li><code>|</code> GFM tables</li>
            <li><code>[x]</code> Task lists</li>
            <li><code>```</code> Code blocks</li>
            <li><code>⌘</code> Keyboard-first</li>
            <li><code>./</code> Folder workspaces</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="compare">
      <div class="container">
        <header class="band">
          <p class="label">03 — Position</p>
          <p class="band__aside">Between a notepad and an IDE.</p>
        </header>
        <div class="compare__wrap">
          <table class="compare__table">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col">Text editor</th>
                <th scope="col">Developer IDE</th>
                <th scope="col" class="is-mark">MarkRust</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Markdown</th>
                <td>None</td>
                <td>Extension</td>
                <td class="is-mark">Native</td>
              </tr>
              <tr>
                <th scope="row">Weight</th>
                <td>Light</td>
                <td>Heavy</td>
                <td class="is-mark">Light</td>
              </tr>
              <tr>
                <th scope="row">Format</th>
                <td>Plain text</td>
                <td>Plain text</td>
                <td class="is-mark">Plain .md</td>
              </tr>
              <tr>
                <th scope="row">Focus</th>
                <td>Everything</td>
                <td>Code projects</td>
                <td class="is-mark">Documents</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="compare__note">
          Built for READMEs, specs, agent prompts, and technical documentation.
          Your documents do not belong to MarkRust.
        </p>
      </div>
    </section>

    <section class="opensource">
      <div class="container opensource__grid">
        <div>
          <header class="band">
            <p class="label">04 — License</p>
          </header>
          <h2>Free means free.</h2>
          <p>
            Open source, intended to remain free forever. No account, no document lock-in,
            no “Pro editor” waiting behind the download button.
          </p>
          <ul class="opensource__meta">
            <li>MPL-2.0</li>
            <li><a href="https://github.com/alexey-a-abramov/markrust">github.com/…/markrust</a></li>
            <li><a href="/docs/contributing">Contribute</a></li>
          </ul>
        </div>
        <pre class="tree" tabindex="0"><code>markrust/
├── crates/
│   ├── markrust-core/
│   ├── markrust-editor/
│   └── markrust-app/
├── LICENSE-MPL-2.0
└── README.md</code></pre>
      </div>
    </section>

    <section class="future">
      <div class="container">
        <p class="label">05 — Extensibility</p>
        <blockquote class="future__quote">
          Markdown is becoming an interface between humans and machines.
          MarkRust intends to remain a very good editor while making those
          workflows safer and easier.
        </blockquote>
        <p class="future__items">
          Git · document history · extensions · MCP · agent-aware workspaces
        </p>
      </div>
    </section>

    <section class="download" id="download">
      <div class="container">
        <header class="band">
          <p class="label">06 — Release</p>
          <p class="band__aside">v0.1.0 · rustc 1.96+</p>
        </header>
        <h2>Download</h2>
        <table class="release">
          <thead>
            <tr>
              <th>Platform</th>
              <th>Arch</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>macOS</td>
              <td><code>aarch64</code> · <code>x86_64</code></td>
              <td>available</td>
              <td><a href="https://github.com/alexey-a-abramov/markrust/releases/latest">Releases →</a></td>
            </tr>
            <tr>
              <td>Linux</td>
              <td><code>x86_64</code></td>
              <td>available</td>
              <td><a href="https://github.com/alexey-a-abramov/markrust/releases/latest">Releases →</a></td>
            </tr>
            <tr>
              <td>Windows</td>
              <td><code>—</code></td>
              <td>planned v0.2</td>
              <td><span class="muted">—</span></td>
            </tr>
          </tbody>
        </table>
        <div class="download__install">
          <p class="label">package managers</p>
          <CodeBlock code={`brew tap alexey-a-abramov/markrust\nbrew install markrust`} terminal />
          <CodeBlock code="cargo install --git https://github.com/alexey-a-abramov/markrust markrust" terminal />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    padding-top: var(--space-8);
    border-bottom: 1px solid var(--color-rule);
  }

  .hero__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .hero__meta span + span::before {
    content: '·';
    margin-right: var(--space-4);
    color: var(--color-rule-strong);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 18ch;
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .hero__lead {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    max-width: 48rem;
  }

  .hero__lead p {
    margin: 0;
    max-width: 28rem;
    color: var(--color-ink-muted);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .hero__lead code {
    font-size: 0.85em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__stage {
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper-warm);
    padding-block: var(--space-6);
  }

  .hero__install {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding: 0.65rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-code-bg);
    border: 1px solid var(--color-code-border);
  }

  .hero__prompt {
    color: var(--color-rust);
    flex-shrink: 0;
  }

  .hero__install code {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: inherit;
    color: var(--color-ink);
  }

  .hero__copy {
    flex-shrink: 0;
    padding: 0.2rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    background: transparent;
    border: 1px solid var(--color-code-border);
    cursor: pointer;
  }

  .hero__copy:hover,
  .hero__copy.is-copied {
    color: var(--color-rust);
    border-color: var(--color-rust);
  }

  .hero__visual {
    min-width: 0;
  }

  .band {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule);
  }

  .band__aside {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .principles,
  .features,
  .compare,
  .opensource,
  .future,
  .download {
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-rule);
  }

  .principles__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .principle {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-rule);
    margin: -1px 0 0 -1px;
  }

  .principle__num {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-style: italic;
    line-height: 1;
    color: var(--color-rust);
  }

  .principle__body h2 {
    margin: 0 0 var(--space-3);
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }

  .principle__body p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .features__split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(14rem, 18rem);
    gap: var(--space-8);
    align-items: start;
  }

  .feature-demo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-surface);
  }

  .feature-demo__pane {
    min-width: 0;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .feature-demo__pane:first-child {
    background: var(--color-code-bg);
    border-right: 1px solid var(--color-rule);
    color: var(--color-ink-muted);
  }

  .feature-demo__caption {
    margin: 0 0 var(--space-3);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .feature-demo__pane pre {
    margin: 0;
    white-space: pre-wrap;
  }

  .tok-h { color: var(--color-ink); font-weight: 500; }
  .tok-task { color: var(--color-rust); }
  .tok-pipe { color: var(--color-ink-faint); }

  .render-h1 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .feature-demo__pane--render p {
    margin: 0 0 0.35rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
  }

  .check { color: var(--color-rust); }
  .box { color: var(--color-ink-faint); }

  .mini-table {
    margin-top: var(--space-4);
    width: 100%;
    border-collapse: collapse;
    font-size: 0.6875rem;
  }

  .mini-table th,
  .mini-table td {
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--color-rule);
    text-align: left;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .index li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.9375rem;
  }

  .index code {
    flex: 0 0 2.75rem;
    font-size: 0.6875rem;
    color: var(--color-rust);
  }

  .compare__wrap {
    overflow-x: auto;
  }

  .compare__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .compare__table th,
  .compare__table td {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-rule);
    text-align: left;
  }

  .compare__table thead th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    background: var(--color-surface-raised);
  }

  .compare__table tbody th {
    font-weight: 500;
    width: 8rem;
  }

  .compare__table .is-mark {
    font-weight: 600;
    background: var(--color-rust-subtle);
  }

  .compare__note {
    margin: var(--space-5) 0 0;
    max-width: 40rem;
    color: var(--color-ink-muted);
  }

  .opensource__grid {
    display: grid;
    grid-template-columns: 1fr minmax(16rem, 22rem);
    gap: var(--space-8);
    align-items: start;
  }

  .opensource h2 {
    margin: 0 0 var(--space-4);
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.03em;
  }

  .opensource p {
    margin: 0;
    max-width: 34rem;
    color: var(--color-ink-muted);
  }

  .opensource__meta {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .opensource__meta li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-rule);
  }

  .tree {
    margin: 0;
    padding: var(--space-5);
    font-size: 0.75rem;
    line-height: 1.6;
    background: var(--color-code-bg);
    border: 1px solid var(--color-code-border);
    overflow-x: auto;
  }

  .future__quote {
    margin: var(--space-5) 0 var(--space-4);
    padding: 0;
    max-width: 40rem;
    border: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .future__items {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-faint);
  }

  .download h2 {
    margin: 0 0 var(--space-6);
    font-size: 1.75rem;
  }

  .release {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin-bottom: var(--space-8);
  }

  .release th,
  .release td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  .release thead th {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    border-top: 1px solid var(--color-rule);
  }

  .release code {
    font-size: 0.75em;
  }

  .muted {
    color: var(--color-ink-faint);
  }

  .download__install :global(.code-block) {
    margin-top: var(--space-3);
  }

  @media (max-width: 900px) {
    .principles__grid,
    .features__split,
    .opensource__grid,
    .feature-demo {
      grid-template-columns: 1fr;
    }

    .hero__stage {
      background: none;
    }

    .feature-demo__pane:first-child {
      border-right: 0;
      border-bottom: 1px solid var(--color-rule);
    }

    .principle {
      margin: -1px 0 0;
    }

    .hero__lead p {
      max-width: none;
    }
  }
</style>
