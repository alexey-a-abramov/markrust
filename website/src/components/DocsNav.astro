---
import { docsNav } from '../data/docs-nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="docs-nav">
  {docsNav.map((section) => (
    <div class="docs-nav__section">
      <p class="docs-nav__heading">{section.title}</p>
      <ul class="docs-nav__list">
        {section.links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href.replace(/\/$/, '') ? 'page' : undefined}
            >
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .docs-nav__section + .docs-nav__section {
    margin-top: var(--space-5);
  }

  .docs-nav__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .docs-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .docs-nav__list a {
    display: block;
    padding: 0.3rem 0;
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3));
  }

  .docs-nav__list a:hover {
    color: var(--color-ink);
  }

  .docs-nav__list a[aria-current='page'] {
    color: var(--color-ink);
    border-left-color: var(--color-rust);
    font-weight: 500;
  }
</style>
