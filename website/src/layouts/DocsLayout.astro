---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsNav from '../components/DocsNav.astro';
import DocsToc from '../components/DocsToc.astro';

interface Props {
  title: string;
  description?: string;
  headings?: { id: string; text: string; level: number }[];
}

const {
  title,
  description = 'MarkRust documentation.',
  headings = [],
} = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article">
  <Header docs />
  <div class="docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <DocsNav />
    </aside>
    <main class="docs-main" id="main-content" tabindex="-1">
      <article class="docs-article prose">
        <header class="docs-header">
          <p class="label">Documentation</p>
          <h1>{title}</h1>
        </header>
        <slot />
      </article>
    </main>
    {headings.length > 0 && (
      <aside class="docs-toc" aria-label="On this page">
        <DocsToc headings={headings} />
      </aside>
    )}
  </div>
  <Footer minimal />
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    min-height: calc(100vh - var(--header-h));
    border-top: 1px solid var(--color-rule);
  }

  .docs-sidebar {
    border-right: 1px solid var(--color-rule);
    padding: var(--space-5) var(--space-4);
    position: sticky;
    top: var(--header-h);
    height: calc(100vh - var(--header-h));
    overflow-y: auto;
    background: var(--color-paper-warm);
  }

  .docs-main {
    padding: var(--space-8) var(--space-6);
    min-width: 0;
  }

  .docs-article {
    max-width: var(--max-content);
  }

  .docs-header {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }

  .docs-header h1 {
    margin: var(--space-3) 0 0;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .docs-toc {
    display: none;
  }

  @media (min-width: 1100px) {
    .docs-shell {
      grid-template-columns: 15rem minmax(0, 1fr) 12rem;
    }

    .docs-toc {
      display: block;
      position: sticky;
      top: var(--header-h);
      height: calc(100vh - var(--header-h));
      overflow-y: auto;
      padding: var(--space-8) var(--space-4);
      border-left: 1px solid var(--color-rule);
    }
  }

  @media (max-width: 768px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      position: fixed;
      inset: var(--header-h) auto 0 0;
      width: min(85vw, 18rem);
      z-index: 40;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.08);
    }

    .docs-sidebar.is-open {
      transform: translateX(0);
    }

    .docs-main {
      padding: var(--space-6) var(--space-4);
    }
  }
</style>

<script>
  const toggle = document.getElementById('docs-nav-toggle');
  const sidebar = document.querySelector('.docs-sidebar');
  toggle?.addEventListener('click', () => {
    sidebar?.classList.toggle('is-open');
  });
</script>
